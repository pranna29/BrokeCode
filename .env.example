# MONGODB_URI: MongoDB Atlas connection string (e.g. mongodb+srv://username:password@cluster.mongodb.net/brokecode?retryWrites=true&w=majority)
# If omitted during local prototyping, an embedded MongoMemoryServer automatically runs in-memory.
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/brokecode?retryWrites=true&w=majority"

# JWT_SECRET: Strong secret key used for signing JSON Web Tokens
JWT_SECRET="your-256-bit-secret-key-here"

# PORT: Server listening port (default: 3000)
PORT="3000"

# NODE_ENV: Application environment (development | production)
NODE_ENV="development"

# GEMINI_API_KEY: Optional backend explanation enhancer key
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"

